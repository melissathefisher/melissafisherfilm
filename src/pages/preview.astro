---
import Layout from '../layouts/Layout.astro';
---

<Layout
  home
  noindex
  image="/images/melissa-fisher-og.jpg"
  favicon="data:,"
  description="Melissa Fisher — award-winning director and writer."
>
  <section class="home-hero portrait-hero" aria-label="Melissa Fisher portrait">
    <img
      class="portrait-hero__image"
      src="/images/melissa-fisher-portrait-square.jpg"
      alt="Melissa Fisher smiling in front of dark curtains."
      width="2500"
      height="2500"
      loading="eager"
      fetchpriority="high"
    />
  </section>
</Layout>

<style>
  :global(html) {
    scrollbar-gutter: auto;
    background: #000;
  }

  .portrait-hero {
    min-height: 0;
  }

  .portrait-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 8%;
  }

  .portrait-hero::after {
    position: absolute;
    inset: 0 0 auto;
    height: 180px;
    content: '';
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent);
  }
</style>
