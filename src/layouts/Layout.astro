---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og.png',
  home = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isBrandCard = image === '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/adelle-sans-300-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isBrandCard && <meta property="og:image:width" content="1200" />}
    {isBrandCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content="Melissa Fisher Director" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Melissa Fisher Director" />
  </head>
  <body class:list={[{ 'home-page': home }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header theme={home ? 'dark' : 'light'} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
